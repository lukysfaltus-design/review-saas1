# Zkopírujte tyto proměnné do Vercel → Settings → Environment Variables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_PASSWORD=

# Poznámka: NOTIFY_EMAIL už není potřeba jako globální proměnná.
# Od verze 2 má KAŽDÝ klient svůj vlastní e-mail majitele (nastavuje se
# v /admin/new nebo v detailu klienta), takže zprávy chodí správnému
# majiteli, ne všem na jednu sdílenou adresu.
